<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      TEACHING POINT: There is deliberately NO
      <uses-permission android:name="android.permission.INTERNET" /> here.
      This app never touches the network. Gemini Nano runs fully on-device through
      Android AICore, so the user's private note never leaves the phone. You can turn
      wifi and mobile data OFF and summarization still works.

      The ML Kit GenAI library requires API level 26. Our app keeps minSdk 24 so it still
      installs on older phones, but the on-device AI code is guarded at runtime (see
      NotesRepository) and shows a friendly "not supported" message on API < 26 or on
      devices without Gemini Nano. tools:overrideLibrary lets us keep minSdk 24 for the app.
    -->
    <uses-sdk tools:overrideLibrary="com.google.mlkit.genai.summarization,com.google.mlkit.genai.common" />

    <!-- Package visibility (Android 11+) so the model card can report whether AICore and
         its Private Compute Services companion are installed, and their versions. These
         are metadata reads only: the app never binds to or calls either package. -->
    <queries>
        <package android:name="com.google.android.aicore" />
        <package android:name="com.google.android.apps.aicore" />
        <package android:name="com.google.android.as" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GeminiNano">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GeminiNano">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>